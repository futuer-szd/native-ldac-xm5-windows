; Derived from Microsoft Simple Audio Sample under the Microsoft Public License.

[Version]
Signature   = "$Windows NT$"
Class       = MEDIA
Provider    = %ProviderName%
ClassGUID   = {4d36e96c-e325-11ce-bfc1-08002be10318}
DriverVer   = 07/22/2026,0.2.1.0
CatalogFile = NativeLdacAudio.cat
PnpLockDown = 1

[SourceDisksNames]
222=%DiskName%,"",222

[SourceDisksFiles]
NativeLdacAudio.sys=222

[SignatureAttributes]
NativeLdacAudio.sys=SignatureAttributes.DRM

[SignatureAttributes.DRM]
DRMLevel=1300

[SignatureAttributes.PETrust]
PETrust=true

[Manufacturer]
%MfgName%=NATIVELDACAUDIO,NT$ARCH$.10.0...22000

[NATIVELDACAUDIO.NT$ARCH$.10.0...22000]
%DeviceDesc%=NATIVELDACAUDIO,ROOT\NativeLdacAudio

[DestinationDirs]
NATIVELDACAUDIO.CopyList=13

[NATIVELDACAUDIO.CopyList]
NativeLdacAudio.sys

[NATIVELDACAUDIO.AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,NativeLdacAudio.sys
HKR,PowerSettings,SingleComponentMultiFxStates,3,1,0,0,0
HKR,PowerSettings,ConservationIdleTime,3,3,0,0,0
HKR,PowerSettings,PerformanceIdleTime,3,3,0,0,0
HKR,PowerSettings,IdlePowerState,3,3,0,0,0
HKR,Drivers,SubClasses,,"wave,midi,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\midi\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%DeviceDesc%

[NATIVELDACAUDIO.I.WaveSpeaker]
AddReg=NATIVELDACAUDIO.I.WaveSpeaker.AddReg

[NATIVELDACAUDIO.I.WaveSpeaker.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%WaveSpeakerName%

[NATIVELDACAUDIO.I.TopologySpeaker]
AddReg=NATIVELDACAUDIO.I.TopologySpeaker.AddReg

[NATIVELDACAUDIO.I.TopologySpeaker.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%TopologySpeakerName%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

[NATIVELDACAUDIO.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration, WDMAUDIO.Registration
CopyFiles=NATIVELDACAUDIO.CopyList
AddReg=NATIVELDACAUDIO.AddReg

[NATIVELDACAUDIO.NT.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_WaveSpeaker%, NATIVELDACAUDIO.I.WaveSpeaker
AddInterface=%KSCATEGORY_RENDER%, %KSNAME_WaveSpeaker%, NATIVELDACAUDIO.I.WaveSpeaker
AddInterface=%KSCATEGORY_REALTIME%, %KSNAME_WaveSpeaker%, NATIVELDACAUDIO.I.WaveSpeaker
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_TopologySpeaker%, NATIVELDACAUDIO.I.TopologySpeaker
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopologySpeaker%, NATIVELDACAUDIO.I.TopologySpeaker

[NATIVELDACAUDIO.NT.Services]
AddService=NativeLdacAudio,0x00000002,NativeLdacAudio.Service

[NativeLdacAudio.Service]
DisplayName=%ServiceDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\NativeLdacAudio.sys

[NATIVELDACAUDIO.NT.HW]
AddReg=AUDIOHW.AddReg

[AUDIOHW.AddReg]
HKR,,DeviceType,0x10001,0x0000001D
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;LS)"

[NATIVELDACAUDIO.NT.Wdf]
KmdfService=NativeLdacAudio,NATIVELDACAUDIO.Wdf

[NATIVELDACAUDIO.Wdf]
KmdfLibraryVersion=$KMDFVERSION$

[Strings]
KSNAME_WaveSpeaker="WaveSpeaker"
KSNAME_TopologySpeaker="TopologySpeaker"
Proxy.CLSID="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER="{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME="{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY="{DDA54A40-1E4C-11D1-A050-405705C10000}"
KSNODETYPE_ANY="{00000000-0000-0000-0000-000000000000}"
PKEY_AudioEndpoint_Association="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
PKEY_AudioEndpoint_Supports_EventDriven_Mode="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"

ProviderName="Native LDAC contributors"
MfgName="Native LDAC contributors"
DiskName="Native LDAC virtual audio endpoint test package"
DeviceDesc="Native LDAC - WH-1000XM5"
ServiceDesc="Native LDAC Virtual Audio Endpoint Driver"
WaveSpeakerName="Native LDAC WaveRT Render"
TopologySpeakerName="Native LDAC Speaker Topology"
