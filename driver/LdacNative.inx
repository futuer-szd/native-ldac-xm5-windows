; SPDX-License-Identifier: Apache-2.0

[Version]
Signature = "$WINDOWS NT$"
Class = Bluetooth
ClassGuid = {e0cbf06c-cd8b-4647-bb8a-263b43f0f974}
Provider = %ProviderName%
DriverVer = 07/21/2026,0.5.0.0
CatalogFile = LdacNative.cat
PnpLockDown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
LdacNative.sys = 1,,

[Manufacturer]
%ManufacturerName% = Models,NTamd64.10.0...19041

[Models.NTamd64.10.0...19041]
; M0 intentionally matches only the Sony WH-1000XM5 tested in this workspace.
%DeviceDescription% = Install,BTHENUM\{0000110b-0000-1000-8000-00805f9b34fb}_VID&0002054C_PID&0DF0

[Install.NT]
CopyFiles = DriverCopy

[DriverCopy]
LdacNative.sys

[Install.NT.Services]
AddService = LdacNative,0x00000002,ServiceInstall

[ServiceInstall]
DisplayName = %ServiceDescription%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %13%\LdacNative.sys

[Install.NT.Wdf]
KmdfService = LdacNative,KmdfSection

[KmdfSection]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
ProviderName = "Native LDAC contributors"
ManufacturerName = "Native LDAC contributors"
DiskName = "Native LDAC test driver package"
DeviceDescription = "Sony WH-1000XM5 Native LDAC Transport (experimental)"
ServiceDescription = "Native LDAC Bluetooth Profile Transport"
